# ==========================================
# APPLICATION
# ==========================================

APP_ENV=production
APP_NAME=Telegram Task Management Platform
DEBUG=false

API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO
LOG_FORMAT=console


# ==========================================
# PUBLIC APPLICATION
# ==========================================

TODO_APP_PORT=8088

VITE_API_BASE_URL=

BACKEND_CORS_ORIGINS=http://localhost:8088


# ==========================================
# POSTGRESQL
# ==========================================

POSTGRES_DB=todo_bot
POSTGRES_USER=todo_bot
POSTGRES_PASSWORD=change-this-to-a-strong-password

DATABASE_URL=postgresql+asyncpg://todo_bot:change-this-to-a-strong-password@postgres:5432/todo_bot


# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379/0


# ==========================================
# TELEGRAM
# ==========================================

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=change-me

TELEGRAM_MINI_APP_URL=https://example.com

TELEGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-secret

TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300


# ==========================================
# DEVELOPMENT AUTH
# ==========================================

DEV_AUTH_ENABLED=false

DEV_AUTH_TELEGRAM_USER_ID=
DEV_AUTH_FIRST_NAME=
DEV_AUTH_USERNAME=
DEV_AUTH_LAST_NAME=
DEV_AUTH_LANGUAGE_CODE=en
DEV_AUTH_TOKEN=